; ZAPmaniac — Godot project
; First-person maze game, ported from the web/Three.js prototype.

config_version=5

[application]

config/name="ZAPmaniac"
config/description="ZAPmaniac: ein First-Person-3D-Labyrinthspiel im Pac-Man-Stil."
run/main_scene="res://scenes/Main.tscn"
config/features=PackedStringArray("4.3", "Forward Plus")
boot_splash/bg_color=Color(0.0196078, 0.0274510, 0.0627451, 1)

[autoload]

SaveMigration="*res://scripts/save_migration.gd"
MazeGen="*res://scripts/maze_gen.gd"
Sfx="*res://scripts/audio_synth.gd"
Speedrun="*res://scripts/speedrun.gd"
Twitch="*res://scripts/twitch_chat.gd"
Leaderboard="*res://scripts/leaderboard.gd"

[display]

window/size/viewport_width=1280
window/size/viewport_height=800
window/stretch/mode="canvas_items"

[input]

move_forward={
"deadzone": 0.2,
"events": [Object(InputEventKey,"resource_local_to_scene":false,"resource_name":"","device":-1,"window_id":0,"alt_pressed":false,"shift_pressed":false,"ctrl_pressed":false,"meta_pressed":false,"pressed":false,"keycode":0,"physical_keycode":87,"key_label":0,"unicode":0,"location":0,"echo":false,"script":null)
]
}
move_back={
"deadzone": 0.2,
"events": [Object(InputEventKey,"resource_local_to_scene":false,"resource_name":"","device":-1,"window_id":0,"alt_pressed":false,"shift_pressed":false,"ctrl_pressed":false,"meta_pressed":false,"pressed":false,"keycode":0,"physical_keycode":83,"key_label":0,"unicode":0,"location":0,"echo":false,"script":null)
]
}
move_left={
