diff --git a/godot/shaders/code_floor.gdshader b/godot/shaders/code_floor.gdshader
new file mode 100644
index 0000000..0ff114a
--- /dev/null
+++ b/godot/shaders/code_floor.gdshader
@@ -0,0 +1,47 @@
+// code_floor.gdshader — PROTOTYP Richtung 1 „Grüner Code“
+// Boden als ruhendes, sehr dunkles Zeichenfeld (Neos Code-Sicht: auch der
+// Boden ist Code), aber völlig statisch: der Boden ist der Ruhepol für das
+// Auge. Rasterlinien je Zelle (2 m) zeigen Gangmitte und Abstand.
+shader_type spatial;
+render_mode unshaded;
+
+uniform vec3 glyph_color = vec3(0.0, 0.16, 0.06);
+uniform vec3 grid_color = vec3(0.0, 0.20, 0.075);
+uniform vec3 bg_color = vec3(0.0, 0.010, 0.004);
+varying vec3 wpos;
+
+const int GLYPH_ROWS[64] = int[64](
+252,8,16,32,64,128,252,0,
+48,72,132,252,132,132,132,0,
+120,128,128,128,128,128,120,0,
+120,140,148,164,196,132,120,0,
+32,96,32,32,32,32,112,0,
+120,132,4,24,96,128,252,0,
+248,4,4,56,4,4,248,0,
+136,136,136,252,8,8,8,0
+);
+
+float hash2(vec2 p) { return fract(sin(dot(p, vec2(12.9898, 78.233))) * 43758.5453123); }
+
+void vertex() {
+	wpos = (MODEL_MATRIX * vec4(VERTEX, 1.0)).xyz;
+}
+
+void fragment() {
+	vec2 p = wpos.xz / 0.25;            // 25-cm-Zeichen
+	vec2 cell = floor(p);
+	vec2 lf = fract(p);
+	vec3 c = bg_color;
+	if (hash2(cell) < 0.35 && lf.x > 0.12 && lf.x < 0.88 && lf.y > 0.12 && lf.y < 0.88) {
+		int gi = int(hash2(cell + 7.0) * 8.0);
+		ivec2 l = clamp(ivec2((lf - 0.12) / 0.76 * 8.0), ivec2(0), ivec2(7));
+		int bit = (GLYPH_ROWS[gi * 8 + l.y] >> (7 - l.x)) & 1;
+		c = mix(c, glyph_color * (0.5 + 0.5 * hash2(cell + 3.0)), float(bit));
+	}
+	// Zellraster: Linien auf den Zellgrenzen (CELL = 2 m, Zentren auf geraden Metern)
+	vec2 g = abs(fract((wpos.xz + 1.0) / 2.0) - 0.5);
+	float line = 1.0 - smoothstep(0.0, 0.012, 0.5 - max(g.x, g.y));
+	c = max(c, grid_color * line);
+	ALBEDO = c;
+	EMISSION = c * 1.2;
+}
diff --git a/godot/shaders/kond_common.gdshaderinc b/godot/shaders/kond_common.gdshaderinc
new file mode 100644
index 0000000..395f9ef
--- /dev/null
+++ b/godot/shaders/kond_common.gdshaderinc
@@ -0,0 +1,110 @@
+// kond_common.gdshaderinc — PROTOTYP Konditions-Looks (Art Direction, nicht freigegeben)
+// Gemeinsame Bausteine für kond_wall/kond_floor: eigener Glyphensatz „ZAC-Code“
+// (8x8, 1-px-Striche, per glyphs.py erzeugt — keine Film-Glyphen, keine Katakana),
+// Hashes, Bayer-Dither, HSV, fwidth-gekoppelte Glyphen/Linien und die
+// Übergangswelle Pac-Man-Basis -> Konditions-Look.
+//
+// Look-IDs (uniform int look):
+//   0 = Pac-Man-Basis (nur Platzhalter für den Übergang; der echte Basis-Look
+//       entsteht im Auftrag pacman_v2)
+//   1 = Matrix          2 = F&L (a) alles ASCII
+//   3 = F&L (b) halluzinogene Wände       4 = F&L (c) Kippbild
+
+const int GLYPH_COUNT = 24;
+const int GLYPH_ROWS[192] = int[192](
+0,0,0,0,0,0,0,0,
+252,8,16,32,64,128,252,0,
+48,72,132,252,132,132,132,0,
+120,128,128,128,128,128,120,0,
+120,140,148,164,196,132,120,0,
+32,96,32,32,32,32,112,0,
+120,132,4,24,96,128,252,0,
+248,4,4,56,4,4,248,0,
+136,136,136,252,8,8,8,0,
+252,128,248,4,4,132,120,0,
+252,4,8,16,32,32,32,0,
+120,132,132,124,4,8,112,0,
+248,8,8,16,32,32,32,0,
+128,128,240,136,136,136,136,0,
+32,252,32,32,32,36,24,0,
+132,132,72,48,72,132,132,0,
+252,132,132,252,128,128,128,0,
+32,32,252,32,80,136,132,0,
+130,130,68,40,16,16,16,0,
+252,32,32,60,32,32,32,0,
+192,32,32,56,36,36,56,0,
+8,16,32,124,16,32,64,0,
+168,0,0,254,16,16,16,0,
+48,48,0,252,0,48,48,0
+);
+
+float k_hash1(float n) { return fract(sin(n) * 43758.5453123); }
+float k_hash2(vec2 p) { return fract(sin(dot(p, vec2(12.9898, 78.233))) * 43758.5453123); }
+
+vec3 k_hsv(float h, float s, float v) {
+	vec3 k = clamp(abs(fract(h + vec3(0.0, 2.0 / 3.0, 1.0 / 3.0)) * 6.0 - 3.0) - 1.0, 0.0, 1.0);
+	return v * mix(vec3(1.0), k, s);
+}
+
+// 4x4-Bayer-Schwelle 0..1 aus FRAGCOORD (bildschirmfest, kein Zeitrauschen)
+float k_bayer(vec2 fc) {
+	ivec2 q = ivec2(mod(fc, 4.0));
+	int i = q.x + q.y * 4;
+	int m[16] = int[16](0, 8, 2, 10, 12, 4, 14, 6, 3, 11, 1, 9, 15, 7, 13, 5);
+	return (float(m[i]) + 0.5) / 16.0;
+}
+
+// Glyphen-Abdeckung 0..1. p in Zeichenzellen (y nach unten), gi Glyph-Index,
+// has = 0/1 ob die Zelle überhaupt ein Zeichen trägt, gfw = Glyph-Texel pro
+// Bildschirmpixel (im Aufrufer per fwidth berechnet, damit die Ableitung in
+// gleichförmigem Kontrollfluss liegt). Ab ~1 Texel/Pixel wird auf die mittlere
+// Deckung des ganzen Feldes überblendet (inkl. leerer Zellen): kein Flimmern
+// und kein Blockmuster auf Distanz, das Zeichenfeld wird zur ruhigen Fläche.
+float k_glyph(vec2 p, int gi, float gfw, float has) {
+	vec2 lf = fract(p);
+	bool in_cell = lf.x > 0.12 && lf.x < 0.88 && lf.y > 0.06 && lf.y < 0.94;
+	ivec2 l = clamp(ivec2(vec2((lf.x - 0.12) / 0.76 * 8.0, (lf.y - 0.06) / 0.88 * 8.0)), ivec2(0), ivec2(7));
+	float bit = in_cell ? float((GLYPH_ROWS[gi * 8 + l.y] >> (7 - l.x)) & 1) : 0.0;
+	return mix(bit * has, 0.15, smoothstep(0.5, 1.2, gfw));
+}
+
+// Drehung der Zelle um k*90° (F&L a: keine „aufrechte Schrift“ als Wand-Hinweis)
+vec2 k_rot_cell(vec2 p, float k) {
+	vec2 c = floor(p);
+	vec2 f = fract(p) - 0.5;
+	if (k < 1.0) return p;
+	if (k < 2.0) return c + vec2(-f.y, f.x) + 0.5;
+	if (k < 3.0) return c - f + 0.5;
+	return c + vec2(f.y, -f.x) + 0.5;
+}
+
+// Glyph-Index einer Zelle; mutiert langsam (je Zelle alle ~3-8 s, also << 3 Hz)
+int k_glyph_index(vec2 cell, float salt, float rate) {
+	float mut = floor(TIME * rate * (0.6 + 0.8 * k_hash2(cell + salt)) + k_hash2(cell.yx + salt) * 10.0);
+	return 1 + int(k_hash2(cell + vec2(mut * 3.1, salt)) * float(GLYPH_COUNT - 1));
+}
+
+// Antialiaste Linie: 1 innerhalb Breite w um d=0, Kante über fwidth(d)
+float k_line(float d, float w, float aa) {
+	return 1.0 - smoothstep(w - aa, w + aa, abs(d));
+}
+
+// Übergangswelle: Schwelle je Zeichenzelle aus Abstand zur Kamera + Zufall.
+// mask=1 -> Konditions-Look; front=1 -> Zelle liegt gerade in der Wellenfront.
+float k_trans_threshold(vec2 cell, float dist, float radius) {
+	return 0.72 * clamp(dist / radius, 0.0, 1.0) + 0.28 * k_hash2(cell * 1.37 + 5.1);
+}
+
+// ---- F&L (a) „alles ASCII“: identisch auf Wand, Boden, Decke ----
+// Farbe hängt nur von x/z und Zeit ab, nie von der Höhe oder der Flächen-
+// orientierung -> Wand und Boden sind absichtlich nicht unterscheidbar.
+vec3 k_fl_a(vec2 p, vec2 cell, vec3 wpos, float gfw, float time) {
+	float hue = 0.78 + 0.13 * sin(wpos.x * 0.21 + time * 0.08) + 0.11 * sin(wpos.z * 0.17 - time * 0.06);
+	float breathe = 0.88 + 0.12 * sin(time * 0.6 + k_hash2(cell) * 6.2832); // 0.1 Hz, weich
+	vec3 bg = k_hsv(hue, 0.55, 0.07);
+	vec3 gl = k_hsv(hue, 0.45, 0.58 * breathe);
+	int gi = k_glyph_index(cell, 3.7, 0.18);
+	float has = step(k_hash2(cell * 1.7 + 0.3), 0.70);
+	vec2 pr = k_rot_cell(p, floor(k_hash2(cell + 11.3) * 4.0));
+	return mix(bg, gl, k_glyph(pr, gi, gfw, has));
+}
diff --git a/godot/shaders/kond_floor.gdshader b/godot/shaders/kond_floor.gdshader
new file mode 100644
index 0000000..b7b6128
--- /dev/null
+++ b/godot/shaders/kond_floor.gdshader
@@ -0,0 +1,111 @@
+// kond_floor.gdshader — PROTOTYP Konditions-Looks für Boden und Decke (Art Direction)
+//
+// Bewusst NICHT unshaded (Auflage aus der Prüfung): Die Geister-Lichter fallen
+// auf den Boden und kündigen einen Geist hinter der Ecke an. Farbe kommt
+// überwiegend als Emission, ALBEDO trägt das Licht.
+// Gleiche Uniforms wie kond_wall (look, transition, flip, reduce_fx).
+
+shader_type spatial;
+render_mode specular_disabled;
+
+#include "res://shaders/kond_common.gdshaderinc"
+
+uniform int look = 1;
+uniform float transition : hint_range(0.0, 1.0) = 1.0;
+uniform float flip : hint_range(0.0, 1.0) = 0.0;
+uniform float reduce_fx : hint_range(0.0, 1.0) = 0.0;
+uniform bool is_ceiling = false;
+uniform vec2 glyph_cell = vec2(0.16, 0.15);
+uniform float transition_radius = 18.0;
+
+uniform vec3 base_floor : source_color = vec3(0.02, 0.025, 0.05);  // Platzhalter Pac-Man-Boden
+uniform vec3 rabbit_white : source_color = vec3(0.95, 0.95, 0.93);
+uniform vec3 mx_glyph : source_color = vec3(0.0, 0.16, 0.06);       // #002910
+uniform vec3 mx_grid : source_color = vec3(0.0, 0.20, 0.075);       // #003313
+uniform vec3 mx_bg : source_color = vec3(0.0, 0.010, 0.004);
+uniform vec3 fb_floor : source_color = vec3(0.07, 0.04, 0.11);      // #120A1C ruhiger Boden (b)
+uniform vec3 fc_carpet_a1 : source_color = vec3(0.24, 0.05, 0.10);  // #3D0D1A Teppich Weinrot
+uniform vec3 fc_carpet_a2 : source_color = vec3(0.05, 0.20, 0.19);  // #0D3330 Teppich Petrol
+uniform vec3 fc_carpet_a3 : source_color = vec3(0.50, 0.20, 0.32);  // #803352 Teppich Altrosa
+
+varying vec3 wpos;
+
+void vertex() {
+	wpos = (MODEL_MATRIX * vec4(VERTEX, 1.0)).xyz;
+}
+
+void fragment() {
+	vec2 p = wpos.xz / glyph_cell;
+	vec2 dp = fwidth(p);
+	float gfw = max(dp.x, dp.y) * 8.0;
+	float dist = length(wpos - CAMERA_POSITION_WORLD);
+	// Zellraster (CELL = 2 m, Zellzentren auf geraden Metern)
+	vec2 gq = (wpos.xz + 1.0) / 2.0;
+	vec2 g = abs(fract(gq) - 0.5);
+	float gd = 0.5 - max(g.x, g.y);
+	float gaa = max(fwidth(gd), 1e-4);
+	float grid_fade = 1.0 - smoothstep(0.02, 0.08, max(fwidth(gq).x, fwidth(gq).y)); // fern: Linie aus statt Moiré
+
+	vec3 base_col = is_ceiling ? vec3(0.0) : base_floor;
+	vec3 col = base_col;
+
+	if (look == 1) {
+		// Matrix: ruhendes Zeichenfeld (25-cm-Zeichen) + Zellraster, völlig statisch
+		vec2 q = wpos.xz / 0.25;
+		vec2 dq = fwidth(q);
+		float qfw = max(dq.x, dq.y) * 8.0;
+		vec2 qc = floor(q);
+		float has = step(k_hash2(qc), 0.35);
+		int gi = 1 + int(k_hash2(qc + 7.0) * 8.0);
+		col = mix(mx_bg, mx_glyph * (0.5 + 0.5 * k_hash2(qc + 3.0)), k_glyph(q, gi, qfw, has));
+		col = max(col, mx_grid * k_line(gd, 0.012, gaa) * grid_fade);
+		if (is_ceiling) col = vec3(0.0);
+	} else if (look == 2) {
+		// F&L (a): exakt dieselbe Funktion wie auf den Wänden (auch an der Decke)
+		col = k_fl_a(p, floor(p), wpos, gfw, TIME);
+		// Komfort-Option: Boden dunkler -> Wand/Boden wieder unterscheidbar
+		col *= mix(1.0, is_ceiling ? 0.15 : 0.35, reduce_fx);
+	} else if (look == 3) {
+		// F&L (b): Boden ist der Ruhepol – dunkel, statisch, nur das Raster
+		col = is_ceiling ? vec3(0.0) : fb_floor;
+		col = max(col, vec3(0.20, 0.12, 0.28) * k_line(gd, 0.012, gaa) * grid_fade * float(!is_ceiling));
+	} else if (look == 4) {
+		// F&L (c): Casino-Teppich (eigenes Rautenmuster, statisch). Kippt mit flip
+		// ins Komplement wie die Wände; Helligkeit bleibt gleich.
+		if (is_ceiling) {
+			col = vec3(0.0);
+		} else {
+			vec2 t = wpos.xz / 1.0;
+			vec2 f = fract(t) - 0.5;
+			float dia = abs(f.x) + abs(f.y);
+			float aa = max(fwidth(dia), 1e-4);
+			float ring = k_line(dia - 0.32, 0.035, aa);
+			float dot_c = 1.0 - smoothstep(0.09 - aa, 0.09 + aa, length(f));
+			vec2 f2 = fract(t + 0.5) - 0.5;
+			float small = 1.0 - smoothstep(0.05 - aa, 0.05 + aa, length(f2));
+			vec3 a1 = fc_carpet_a1;
+			vec3 a2 = fc_carpet_a2;
+			vec3 a3 = fc_carpet_a3;
+			// Komplement: Rot <-> Petrol tauschen, Altrosa -> Türkis
+			vec3 b3 = vec3(0.16, 0.42, 0.45);
+			vec3 c1 = mix(a1, a2, flip);
+			vec3 c2 = mix(a2, a1, flip);
+			vec3 c3 = mix(a3, b3, flip);
+			col = mix(c1, c2, step(0.32, dia));
+			col = mix(col, c3, max(ring, max(dot_c, small)));
+			col *= 0.8;
+		}
+	}
+
+	float th = k_trans_threshold(floor(p), dist, transition_radius);
+	float mask = step(th, transition * 1.0001);
+	float front = (1.0 - smoothstep(0.0, 0.045, abs(transition - th))) * step(0.001, transition) * step(transition, 0.999) * float(look != 0);
+	float fl = k_glyph(p, k_glyph_index(floor(p), 9.1, 2.0), gfw, 1.0) * front;
+	vec3 out_col = mix(base_col, col, mask);
+	out_col = mix(out_col, rabbit_white * 0.7, fl);
+
+	float alb = (look == 2) ? mix(0.6, 0.08, mask) : 0.6;
+	ALBEDO = out_col * alb + vec3(0.02);
+	EMISSION = out_col * 1.1;
+	ROUGHNESS = 1.0;
+}
diff --git a/godot/shaders/kond_wall.gdshader b/godot/shaders/kond_wall.gdshader
new file mode 100644
index 0000000..72d4964
--- /dev/null
+++ b/godot/shaders/kond_wall.gdshader
@@ -0,0 +1,237 @@
+// kond_wall.gdshader — PROTOTYP Konditions-Looks für Wände (Art Direction, nicht freigegeben)
+//
+// Ein Wand-Material für den Speedrun: Basis-Look (Platzhalter) und alle
+// Konditions-Looks, umgeschaltet nur über Uniforms (look, transition, flip,
+// reduce_fx). Zur Laufzeit tweent das Spiel `transition` 0->1 beim Aufheben
+// des White-Rabbit-Pickups und 1->0 beim Ende der Kondition.
+//
+// Glyphen liegen in Weltkoordinaten (nicht je Box-UV): gleiche Zeichengröße
+// auf jeder Wand, lückenlose Spalten über Blockgrenzen und — für F&L (a) —
+// exakt dasselbe Raster wie auf dem Boden.
+//
+// Kosten: ein Glyph-Lookup (Konstanten-Array) + wenige Hashes je Pixel, ein
+// Zweig je Look (Uniform -> kohärent). Matrix: cull_disabled verdoppelt nur
+// die Wand-Rasterung, wenn man in einer Wand steht.
+
+shader_type spatial;
+render_mode cull_disabled, depth_draw_opaque, specular_disabled;
+
+#include "res://shaders/kond_common.gdshaderinc"
+
+uniform int look = 1;
+uniform float transition : hint_range(0.0, 1.0) = 1.0; // 0 = Basis, 1 = Kondition
+uniform float flip : hint_range(0.0, 1.0) = 0.0;       // F&L (c): 1 = Steuerung invertiert
+uniform float reduce_fx : hint_range(0.0, 1.0) = 0.0;  // Option „Effekte reduzieren“
+uniform vec2 glyph_cell = vec2(0.16, 0.15);            // Zeichenzelle in m (B x H)
+uniform float wall_top = 4.4;
+uniform float transition_radius = 18.0;
+
+// Basis-Platzhalter (Pac-Man-Labyrinth: Navy + doppelte Neonlinie)
+uniform vec3 base_body : source_color = vec3(0.035, 0.05, 0.16);   // #090D29
+uniform vec3 base_line : source_color = vec3(0.17, 0.42, 1.0);     // #2B6BFF
+// Übergang: Wellenfront in „Hasenweiß“
+uniform vec3 rabbit_white : source_color = vec3(0.95, 0.95, 0.93); // #F2F2ED
+// Matrix
+uniform vec3 mx_bg : source_color = vec3(0.0, 0.012, 0.004);       // #000301
+uniform vec3 mx_dim : source_color = vec3(0.0, 0.10, 0.035);       // #001A09
+uniform vec3 mx_glyph : source_color = vec3(0.0, 0.85, 0.30);      // #00D94D
+uniform vec3 mx_head : source_color = vec3(0.80, 1.0, 0.86);       // #CCFFDB
+uniform vec3 mx_edge : source_color = vec3(0.0, 0.55, 0.22);       // #008C38
+uniform float mx_fall_speed = 8.0;
+uniform float mx_active_cols = 0.6;
+uniform float mx_near_density = 0.08; // Anteil gezeichneter Pixel direkt vor der Kamera
+uniform float mx_mid_density = 0.72;  // ... in Gangbreite (Rasterglas)
+uniform float mx_far_density = 0.94;  // ... in der Ferne (Labyrinth bleibt lesbar)
+// F&L (c) Kippbild: zwei Paletten mit ähnlicher Helligkeit (kein Hell-Dunkel-Sprung)
+uniform vec3 fc_a_low : source_color = vec3(0.17, 0.04, 0.24);     // #2B0A3D
+uniform vec3 fc_a_mid : source_color = vec3(0.70, 0.09, 0.36);     // #B3175C
+uniform vec3 fc_a_high : source_color = vec3(0.95, 0.42, 0.20);    // #F26B33
+uniform vec3 fc_b_low : source_color = vec3(0.03, 0.18, 0.20);     // #072E33
+uniform vec3 fc_b_mid : source_color = vec3(0.06, 0.55, 0.52);     // #0F8C85
+uniform vec3 fc_b_high : source_color = vec3(0.30, 0.80, 0.95);    // #4DCCF2
+
+varying vec3 wpos;
+varying vec3 wnrm;
+varying vec3 inst_origin;
+varying vec3 inst_half;
+
+void vertex() {
+	wpos = (MODEL_MATRIX * vec4(VERTEX, 1.0)).xyz;
+	wnrm = (MODEL_MATRIX * vec4(NORMAL, 0.0)).xyz;
+	inst_origin = MODEL_MATRIX[3].xyz;
+	// BoxMesh (CELL, 1, CELL): halbe Ausdehnung lokal (1, 0.5, 1) x Instanz-Skalierung
+	inst_half = vec3(length(MODEL_MATRIX[0].xyz), 0.5 * length(MODEL_MATRIX[1].xyz), length(MODEL_MATRIX[2].xyz));
+}
+
+vec3 sunset(float h, vec3 lo, vec3 mi, vec3 hi) {
+	return h < 0.5 ? mix(lo, mi, h * 2.0) : mix(mi, hi, h * 2.0 - 1.0);
+}
+
+void fragment() {
+	vec3 n = normalize(wnrm);
+	bool vert = abs(n.y) < 0.5;
+	vec3 tng = vert ? normalize(cross(vec3(0.0, 1.0, 0.0), n)) : vec3(1.0, 0.0, 0.0);
+	float u_m = vert ? dot(wpos, tng) : wpos.x;          // waagrecht in m
+	float v_m = vert ? (wall_top - wpos.y) : wpos.z;     // von oben nach unten in m
+	vec2 p = vec2(u_m, v_m) / glyph_cell;
+	vec2 face_salt = floor(n.xz * 3.0 + 3.5) * 17.0;
+
+	// F&L (b): Wände atmen/wabern (heutiges psychedelic_amount, beruhigt)
+	float wob = (look == 3) ? (1.0 - 0.75 * reduce_fx) : 0.0;
+	vec2 pw = p;
+	pw.x += sin(p.y * 0.45 + TIME * 1.1) * 0.55 * wob;
+	pw.y += sin(p.x * 0.35 + TIME * 0.8) * 0.45 * wob;
+	pw *= 1.0 + 0.06 * wob * sin(TIME * 0.9);
+
+	// Ableitungen in gleichförmigem Kontrollfluss
+	vec2 dpw = fwidth(pw);
+	float gfw = max(dpw.x, dpw.y) * 8.0;
+	vec2 cell = floor(pw);
+	float dist = length(wpos - CAMERA_POSITION_WORLD);
+
+	vec3 rel = wpos - inst_origin;
+	float d_top = inst_half.y - rel.y;        // Abstand zur Oberkante (m)
+	float d_bot = inst_half.y + rel.y;        // Abstand zur Unterkante (m)
+	float aa_top = max(fwidth(d_top), 1e-4);
+
+	// ---------------- Basis-Platzhalter ----------------
+	vec3 base_col = base_body;
+	float bl = max(k_line(d_top - 0.06, 0.025, aa_top), k_line(d_top - 0.20, 0.025, aa_top));
+	bl = max(bl, max(k_line(d_bot - 0.06, 0.025, aa_top), k_line(d_bot - 0.20, 0.025, aa_top)));
+	base_col = mix(base_col, base_line, bl);
+	float base_em = 0.25 + 1.6 * bl;
+
+	// ---------------- Konditions-Look ----------------
+	vec3 col = vec3(0.0);
+	float em = 1.0;
+	float lit = 0.0;      // Glyph-Deckung (für Dither und Übergang)
+	float density = 1.0;  // Anteil gezeichneter Pixel außerhalb der Regenspuren (Matrix: durchlässig)
+	float inrain = 0.0;   // 1 = Pixel gehört zu einer leuchtenden Regenspur (immer solide)
+
+	if (look == 0) {
+		col = base_col;
+		em = base_em;
+	} else if (look == 1) {
+		// MATRIX — „Grüner Code“, durchlässig: stehende Zeichenspalten, wandernde
+		// Schreibköpfe; Hintergrund per Bayer-Raster nur teilweise gezeichnet
+		// (nah ~10 %, fern ~85 %): man sieht durch die Wand den nächsten Gang.
+		float colseed = k_hash1(cell.x * 91.7 + face_salt.x + face_salt.y * 0.37);
+		int gi = k_glyph_index(cell + face_salt, 1.3, 0.22);
+		float has = step(k_hash2(cell * 1.7 + face_salt), 0.72);
+		lit = k_glyph(pw, gi, gfw, has);
+		col = mix(mx_bg, mx_dim, lit * 0.9);
+		float rows_h = wall_top / glyph_cell.y;
+		if (colseed < mx_active_cols) {
+			float span = rows_h * 1.8;
+			float speed = mx_fall_speed * (0.65 + 0.7 * k_hash1(colseed * 77.0));
+			float head = floor(fract(TIME * speed / span + colseed * 5.0) * span) - rows_h * 0.3;
+			float trail = mix(8.0, 22.0, k_hash1(colseed * 33.0));
+			float d = head - cell.y;
+			if (d >= 0.0 && d < trail) {
+				float k = 1.0 - d / trail;
+				vec3 c = (d < 1.0) ? mx_head : mx_glyph * (0.25 + 0.75 * k * k);
+				col = mix(col, c, lit);
+				inrain = lit;
+			}
+		}
+		// Konstrukt-Kante oben: einzige durchgehende Linie, zeigt die Wandhöhe
+		col = max(col, mx_edge * k_line(d_top - 0.03, 0.02, aa_top));
+		// unterer Streifen ruhig (Boden-Anker)
+		float calm = smoothstep(0.0, 0.9, d_bot);
+		col = mix(mix(mx_bg, mx_dim, lit * 0.9), col, calm);
+		// nah (< ~1,2 m) öffnet sich die Wand fast ganz, mittlere Distanz Rasterglas,
+		// fern fast dicht -> Labyrinthstruktur bleibt lesbar
+		density = mix(mx_near_density, mx_mid_density, smoothstep(0.45, 1.3, dist));
+		density = mix(density, mx_far_density, smoothstep(2.5, 8.0, dist));
+		density = mix(density, 1.0, reduce_fx);   // „Effekte reduzieren“: Wände wieder dicht
+		if (!FRONT_FACING) {
+			// in der Wand: Rückseiten als gedimmter Code -> „ich bin im Programm“
+			col *= 0.45;
+			density *= 0.5;
+		}
+		em = 1.35;
+	} else if (look == 2) {
+		// F&L (a) — ALLES ASCII: identisch zu Boden und Decke
+		vec2 cell_a = floor(p);
+		col = k_fl_a(p, cell_a, wpos, gfw, TIME);
+		// Komfort-Option: Fußleiste trennt Wand und Boden wieder
+		float skirt = k_line(d_bot - 0.05, 0.03, max(fwidth(d_bot), 1e-4));
+		col = mix(col, vec3(0.95, 0.85, 1.0) * 0.55, skirt * reduce_fx);
+		col *= mix(1.0, 1.15, reduce_fx);
+		em = 1.2;
+	} else if (look == 3) {
+		// F&L (b) — HALLUZINOGENE WÄNDE: heutiger Effekt (Regenbogen + Wabern),
+		// aber Helligkeit gedeckelt (Objekte bleiben heller als jede Wand),
+		// Farbwanderung langsam (Hue-Umlauf ~16 s), Boden ruhig.
+		float colseed = k_hash1(cell.x * 91.7 + face_salt.x + face_salt.y * 0.37);
+		int gi = k_glyph_index(cell + face_salt, 1.3, 0.22);
+		float has = step(k_hash2(cell * 1.7 + face_salt), 0.72);
+		lit = k_glyph(pw, gi, gfw, has);
+		float hue = fract(TIME * 0.06 + wpos.y * 0.07 + u_m * 0.045);
+		float sat = mix(0.85, 0.45, reduce_fx);
+		vec3 bg = k_hsv(hue + 0.08, 0.8, 0.14);
+		vec3 gl = k_hsv(hue, sat, 0.62);
+		col = mix(bg, gl, lit);
+		float rows_h = wall_top / glyph_cell.y;
+		if (colseed < 0.45) {
+			float span = rows_h * 1.8;
+			float head = floor(fract(TIME * 5.0 / span + colseed * 5.0) * span) - rows_h * 0.3;
+			float d = head - cell.y;
+			if (d >= 0.0 && d < 14.0) {
+				col = mix(col, k_hsv(hue + 0.08, sat * 0.6, 0.78), lit * (1.0 - d / 14.0));
+			}
+		}
+		em = 1.25;
+	} else if (look == 4) {
+		// F&L (c) — KIPPBILD: Wüsten-Neon in schmelzenden Streifen. Wenn die
+		// Steuerung invertiert ist (flip=1), kippt die Palette ins Komplement
+		// und die Streifen fließen nach oben statt nach unten. Gleiche Helligkeit
+		// in beiden Zuständen -> kein Blitz, aber eindeutiges Signal.
+		float dir = mix(1.0, -1.0, step(0.5, flip));
+		float colw = 0.22;                          // Tropfspalten 22 cm
+		float dcol = floor(u_m / colw);
+		float drip = (0.10 * sin(u_m * 2.3) + 0.06 * sin(u_m * 5.9 + 1.7) + 0.16 * k_hash1(dcol * 13.7 + face_salt.x)) * (1.0 - 0.6 * reduce_fx);
+		float heat = sin(u_m * 1.3 + TIME * 0.5) * 0.18 * (1.0 - 0.7 * reduce_fx);
+		float s = (wpos.y + drip + heat) * 1.1 + TIME * 0.12 * dir;   // ruhiges Fließen (~0,1 Streifen/s)
+		float band = fract(s);
+		float aa = max(fwidth(s), 1e-4);
+		float stripe = smoothstep(0.5 - aa, 0.5 + aa, band) * (1.0 - smoothstep(1.0 - aa, 1.0, band));
+		float h = clamp(wpos.y / wall_top, 0.0, 1.0);
+		vec3 pa = sunset(h, fc_a_low, fc_a_mid, fc_a_high);
+		vec3 pb = sunset(h, fc_b_low, fc_b_mid, fc_b_high);
+		vec3 pal = mix(pa, pb, flip);
+		col = mix(pal * 0.42, pal * 0.76, stripe);
+		// Fußleiste dunkel: Bodenkante bleibt immer lesbar
+		col *= mix(0.35, 1.0, smoothstep(0.0, 0.35, d_bot));
+		em = 1.1;
+	}
+
+	// ---------------- Übergang Basis -> Kondition ----------------
+	float th = k_trans_threshold(floor(p), dist, transition_radius);
+	float mask = step(th, transition * 1.0001);
+	float front = (1.0 - smoothstep(0.0, 0.045, abs(transition - th))) * step(0.001, transition) * step(transition, 0.999) * float(look != 0);
+	// In der Front zerfallen die Linien zu Zeichen: Glyphe in Hasenweiß
+	float fl = k_glyph(p, k_glyph_index(floor(p), 9.1, 2.0), gfw, 1.0) * front;
+
+	vec3 out_col = mix(base_col, col, mask);
+	float out_em = mix(base_em, em, mask);
+	out_col = mix(out_col, rabbit_white * 0.9, fl);
+	out_em = mix(out_em, 1.4, fl);
+
+	// Matrix-Durchlässigkeit (nur wo der Konditions-Look schon gilt)
+	if (look == 1 && mask > 0.5 && fl < 0.5) {
+		// Regenspuren bleiben solide, außer direkt vor der Kamera (sonst
+		// verdecken riesige Zeichen den Blick, wenn man durch die Wand läuft)
+		float keep = inrain > 0.5 ? mix(0.4, 1.0, smoothstep(0.4, 1.2, dist)) : density;
+		if (k_bayer(FRAGCOORD.xy) > keep) {
+			discard;
+		}
+	}
+
+	// F&L (a): kaum Licht-Anteil, damit Wandflächen nicht über die Schattierung
+	// von Boden und Nachbarwand unterscheidbar werden
+	float alb = (look == 2) ? mix(0.35, 0.08, mask) : 0.35;
+	ALBEDO = out_col * alb;
+	EMISSION = out_col * out_em;
+	ROUGHNESS = 0.9;
+}
