diff --git a/godot/scripts/kond_looks.gd b/godot/scripts/kond_looks.gd
new file mode 100644
index 0000000..6f141cd
--- /dev/null
+++ b/godot/scripts/kond_looks.gd
@@ -0,0 +1,73 @@
+extends RefCounted
+## KondLooks — PROTOTYP (Art Direction, nicht freigegeben): die Konditions-
+## Looks des Speedruns als reine Daten + eine apply()-Funktion. Kein Neuaufbau
+## der Szene: Wand-, Boden- und Deckenmaterial sind immer kond_wall/kond_floor,
+## ein Look ist nur ein Satz Uniforms + Umgebung (Nebel) + Objekt-Kontur.
+##
+## Laufzeit (Vorschlag für die Umsetzung): White-Rabbit-Pickup -> Zufalls-
+## Kondition -> apply(main, id, t) mit t per Tween 0->1 in 0,8 s; Ende der
+## Kondition -> t 1->0 in 0,8 s. F&L (c) setzt zusätzlich `flip` aus dem
+## Inversionszustand der Steuerung (siehe fear_and_loathing.gd look_flip).
+
+const LOOKS := {
+	"pacman": {"look": 0, "outline": false,
+		"bg": Color(0, 0, 0), "fog": Color(0, 0, 0), "fog_density": 0.03,
+		"ambient": Color(0.45, 0.55, 0.6), "ambient_energy": 0.6},
+	"matrix": {"look": 1, "outline": false,
+		"bg": Color(0, 0, 0), "fog": Color(0.0, 0.035, 0.012), "fog_density": 0.05,
+		"ambient": Color(0.2, 0.6, 0.3), "ambient_energy": 0.5},
+	"fl_a": {"look": 2, "outline": true,
+		"bg": Color("0b0614"), "fog": Color("0b0614"), "fog_density": 0.085,
+		"ambient": Color(0.5, 0.4, 0.6), "ambient_energy": 0.5},
+	"fl_b": {"look": 3, "outline": true,
+		"bg": Color("07040c"), "fog": Color("0e0618"), "fog_density": 0.04,
+		"ambient": Color(0.5, 0.4, 0.6), "ambient_energy": 0.5},
+	"fl_c": {"look": 4, "outline": true,
+		"bg": Color("120610"), "fog": Color("1a0814"), "fog_density": 0.04,
+		"ambient": Color(0.6, 0.4, 0.4), "ambient_energy": 0.5},
+}
+
+## Schwarze Kontur (Inverted Hull) für Kugeln, Power-Kugel und Geister in den
+## F&L-Looks: Objekte bleiben vor bunten Wänden als Form lesbar.
+static var _outline: StandardMaterial3D = null
+
+
+static func outline_material() -> StandardMaterial3D:
+	if _outline == null:
+		_outline = StandardMaterial3D.new()
+		_outline.shading_mode = BaseMaterial3D.SHADING_MODE_UNSHADED
+		_outline.albedo_color = Color(0.0, 0.0, 0.0)
+		_outline.cull_mode = BaseMaterial3D.CULL_FRONT
+		_outline.grow = true
+		_outline.grow_amount = 0.022
+	return _outline
+
+
+static func _param(mat, param: String, value) -> void:
+	if mat is ShaderMaterial:
+		mat.set_shader_parameter(param, value)
+
+
+## Setzt Look `id` mit Übergangsstand `t` (0 = Basis, 1 = Kondition).
+static func apply(main, id: String, t: float = 1.0, flip: float = 0.0, reduce_fx: float = 0.0) -> void:
+	var d: Dictionary = LOOKS[id]
+	var mv = main.maze_view
+	for mat in [mv.wall_material, mv.floor_shader_material, mv.ceil_shader_material]:
+		_param(mat, "look", d.look)
+		_param(mat, "transition", t)
+		_param(mat, "flip", flip)
+		_param(mat, "reduce_fx", reduce_fx)
+	# Nebel/Umgebung mit dem Übergang mischen
+	var b: Dictionary = LOOKS.pacman
+	var env: Environment = main.world_env.environment
+	env.background_color = b.bg.lerp(d.bg, t)
+	env.fog_light_color = b.fog.lerp(d.fog, t)
+	env.fog_density = lerpf(b.fog_density, d.fog_density, t)
+	env.ambient_light_color = b.ambient.lerp(d.ambient, t)
+	env.ambient_light_energy = lerpf(b.ambient_energy, d.ambient_energy, t)
+	# Kontur an/aus (ab halbem Übergang)
+	var ol = outline_material() if (d.outline and t >= 0.5) else null
+	mv.pellet_material.next_pass = ol
+	mv.power_material.next_pass = ol
+	for e in main.enemies:
+		e.body_material.next_pass = ol
