diff --git a/godot/shaders/crt_overlay.gdshader b/godot/shaders/crt_overlay.gdshader
new file mode 100644
index 0000000..2b90fca
--- /dev/null
+++ b/godot/shaders/crt_overlay.gdshader
@@ -0,0 +1,20 @@
+// crt_overlay.gdshader — PROTOTYP Pac-Man v2: statische Arcade-Anmutung.
+// Auflösungsunabhängig: feste Zahl Zeilen je Bildhöhe (line_count) statt
+// „jede 3. Pixelzeile“; Kanten über fwidth geglättet, damit bei 720p wie bei
+// 4K dieselbe Struktur entsteht und nichts schwebt. Vignette in SCREEN_UV.
+// Kein Flimmern, keine Bildkrümmung, keine Farbsäume (Komfort, Lesbarkeit).
+shader_type canvas_item;
+uniform float line_count = 270.0;   // Zeilen je Bildhöhe (unabhängig von der Auflösung)
+uniform float line_strength = 0.22;
+uniform float vignette = 0.5;
+void fragment() {
+	float y = SCREEN_UV.y * line_count;
+	float fw = max(fwidth(y), 1e-4);
+	// dunkles Drittel jeder Zeile, geglättet
+	float p = fract(y);
+	float dark = clamp((0.33 - p) / fw + 0.5, 0.0, 1.0);
+	dark *= clamp(1.0 / (fw * 3.0), 0.0, 1.0);   // < 3 px je Zeile: Struktur weich ausblenden statt Moiré
+	vec2 d = SCREEN_UV - vec2(0.5);
+	float v = smoothstep(0.35, 0.85, length(d * vec2(1.0, 1.25))) * vignette;
+	COLOR = vec4(0.0, 0.0, 0.0, clamp(dark * line_strength + v, 0.0, 0.85));
+}
diff --git a/godot/shaders/pacman_floor.gdshader b/godot/shaders/pacman_floor.gdshader
new file mode 100644
index 0000000..0394ae5
--- /dev/null
+++ b/godot/shaders/pacman_floor.gdshader
@@ -0,0 +1,66 @@
+// pacman_floor.gdshader — PROTOTYP „Pac-Man-Basislook v2“ (Art Direction, nicht freigegeben)
+//
+// Beleuchteter (NICHT unshaded) dunkler Boden: das OmniLight der Geister färbt
+// ihn um Ecken herum als Vorwarnung. Darauf, emissiv und fwidth-geglättet:
+//  - Kachelraster in Zellgröße: Querstriche alle CELL Meter -> Tempogefühl
+//  - Kreuzungsrahmen: gefastes Achteck auf jeder Zelle mit >= 3 offenen
+//    Nachbarn -> Abzweigungen schon aus der Distanz erkennbar
+// Zellkarte kommt als Textur (1 Pixel je Zelle, R = Wand, G = Kreuzung).
+shader_type spatial;
+render_mode specular_schlick_ggx;
+
+uniform sampler2D maze_tex : filter_nearest;
+uniform vec2 maze_size = vec2(21.0, 19.0);
+uniform float cell = 2.0;
+uniform vec3 floor_albedo : source_color = vec3(0.035, 0.04, 0.065);
+uniform vec3 line_top : source_color = vec3(0.118, 0.949, 0.784);
+uniform vec3 line_base : source_color = vec3(0.043, 0.498, 0.659);
+uniform float grid_w = 0.06;
+uniform float grid_strength = 1.0;
+uniform float junction_half = 0.6;    // halbe Kantenlänge des Kreuzungsrahmens (m)
+uniform float junction_chamfer = 0.38;
+uniform float junction_w = 0.06;
+uniform float junction_strength = 0.75;
+
+varying vec3 wpos;
+
+void vertex() {
+	wpos = (MODEL_MATRIX * vec4(VERTEX, 1.0)).xyz;
+}
+
+float line_aa(float d, float w) {
+	float fw = max(fwidth(d), 1e-5);
+	float wc = max(w, fw);
+	float a = clamp((wc * 0.5 - abs(d)) / fw + 0.5, 0.0, 1.0);
+	return a * clamp(w / fw, 0.0, 1.0);
+}
+
+void fragment() {
+	// Zelle (r, c) hat ihr Zentrum bei (x = c*cell, z = r*cell)
+	vec2 g = vec2(wpos.x, wpos.z) / cell + 0.5;
+	ivec2 ci = ivec2(floor(g));
+	vec4 m = vec4(1.0, 0.0, 0.0, 1.0);
+	if (ci.x >= 0 && ci.y >= 0 && float(ci.x) < maze_size.x && float(ci.y) < maze_size.y) {
+		m = texelFetch(maze_tex, ci, 0);
+	}
+	vec2 local = (fract(g) - 0.5) * cell;   // Meter ab Zellmitte
+
+	// Kachelraster: Abstand zur nächsten Zellgrenze
+	vec2 db = cell * 0.5 - abs(local);
+	float grid = max(line_aa(db.x, grid_w), line_aa(db.y, grid_w));
+	float fade = clamp(1.0 - max(fwidth(g.x), fwidth(g.y)) * 6.0, 0.0, 1.0); // weit weg ausblenden
+	vec3 em = line_base * grid * grid_strength * fade;
+
+	if (m.g > 0.5) {
+		vec2 q = abs(local);
+		float d_sq = max(q.x, q.y) - junction_half;
+		float d_ch = (q.x + q.y - (2.0 * junction_half - junction_chamfer)) * 0.70710678;
+		float d = max(d_sq, d_ch);
+		float frame = line_aa(d, junction_w);
+		float inner = (1.0 - smoothstep(-0.02, 0.02, d)) * 0.05;
+		em += line_top * (frame * junction_strength + inner);
+	}
+	ALBEDO = floor_albedo;
+	ROUGHNESS = 0.85;
+	EMISSION = em;
+}
diff --git a/godot/shaders/pacman_wall.gdshader b/godot/shaders/pacman_wall.gdshader
new file mode 100644
index 0000000..b2ba2bd
--- /dev/null
+++ b/godot/shaders/pacman_wall.gdshader
@@ -0,0 +1,133 @@
+// pacman_wall.gdshader — PROTOTYP „Pac-Man-Basislook v2“ (Art Direction, nicht freigegeben)
+//
+// Arcade-Maze-Prinzip (beschrieben, nicht kopiert): Wände sind dunkle Masse
+// mit Leuchtkontur, Gänge sind dunkle Kanäle. Eigenständig gegenüber dem
+// Original durch: EINE kräftige Leuchtkante statt dünner Doppellinie, Farbe
+// Türkis mit Verlauf je Level (nie Blau), gefaste 45°-Ecken statt runder,
+// Taktstrich-Sockel (gibt Tempo), schraffierte Deckfläche.
+// Welche Nachbarn Wand sind, schreibt MazeView je Instanz in INSTANCE_CUSTOM.
+// Technik: alle Linien über fwidth() kantengeglättet (kein Flimmern auf
+// Distanz), Masse beleuchtet (Geister-OmniLight als Vorwarnung sichtbar),
+// psychedelic_amount für den Fear-&-Loathing-Pickup (MazeView.set_psychedelic).
+shader_type spatial;
+render_mode cull_back, specular_disabled;
+
+uniform vec3 line_top : source_color = vec3(0.118, 0.949, 0.784);  // #1EF2C8
+uniform vec3 line_base : source_color = vec3(0.043, 0.498, 0.659); // #0B7FA8 (je Level)
+uniform vec3 body_color : source_color = vec3(0.024, 0.078, 0.11); // #06141C
+uniform float cell = 2.0;          // MazeView.CELL; BoxMesh ist cell x 1 x cell
+uniform float edge_w = 0.11;       // Leuchtkante oben (m)
+uniform float base_w = 0.04;       // Sockellinie (m)
+uniform float dash_len = 0.5;      // Taktstrich-Periode (m)
+uniform float dash_y = 0.24;       // Höhe der Taktstriche über Boden (m)
+uniform float dash_h = 0.09;
+uniform float chamfer = 0.5;       // Fase an freien Außenecken der Deckfläche (m)
+uniform float cap_w = 0.07;        // Leuchtkante der Deckfläche (m)
+uniform float emission_gain = 2.4;
+uniform float psychedelic_amount = 0.0;
+
+varying vec3 wpos;
+varying vec3 wnorm;
+varying vec4 nb;    // r: Wand bei row-1 (-Z), g: row+1 (+Z), b: col-1 (-X), a: col+1 (+X)
+varying vec3 center;
+varying float half_h;
+varying float half_w;
+
+void vertex() {
+	wpos = (MODEL_MATRIX * vec4(VERTEX, 1.0)).xyz;
+	wnorm = normalize((MODEL_MATRIX * vec4(NORMAL, 0.0)).xyz);
+	nb = INSTANCE_CUSTOM;
+	center = (MODEL_MATRIX * vec4(0.0, 0.0, 0.0, 1.0)).xyz;
+	half_h = length(MODEL_MATRIX[1].xyz) * 0.5;
+	half_w = length(MODEL_MATRIX[0].xyz) * cell * 0.5;
+}
+
+// Kantengeglättete Linie: d = Abstand zur Mittellinie (m), w = Breite (m).
+// Unter einem Pixel Breite wird die Linie 1 px breit und entsprechend dunkler
+// gezeichnet statt zu zerfallen – kein Flimmern auf Distanz.
+float line_aa(float d, float w) {
+	float fw = max(fwidth(d), 1e-5);
+	float wc = max(w, fw);
+	float a = clamp((wc * 0.5 - abs(d)) / fw + 0.5, 0.0, 1.0);
+	return a * clamp(w / fw, 0.0, 1.0);
+}
+
+vec3 hue_shift(vec3 c, float a) {
+	const vec3 k = vec3(0.57735);
+	float ca = cos(a);
+	return c * ca + cross(k, c) * sin(a) + k * dot(k, c) * (1.0 - ca);
+}
+
+void fragment() {
+	float H = 2.0 * half_h;
+	float y = wpos.y - (center.y - half_h);   // 0 = Boden
+	float top = H - y;                          // 0 = Oberkante
+	if (psychedelic_amount > 0.001) {
+		y += sin(wpos.x * 2.1 + wpos.z * 1.7 + TIME * 2.3) * 0.12 * psychedelic_amount;
+		top = H - y;
+	}
+	vec3 grad = mix(line_base, line_top, smoothstep(0.0, H, y));
+	vec3 albedo = body_color * mix(1.0, 0.45, clamp(y / max(H, 0.01), 0.0, 1.0));
+	vec3 em = vec3(0.0);
+
+	if (wnorm.y > 0.5) {
+		// Deckfläche (nur bei niedrigen Wänden sichtbar): gefüllter Block mit
+		// Leuchtkante an freien Kanten, gefaste Außenecken, feine Diagonal-Schraffur.
+		float dx = wpos.x - center.x;
+		float dz = wpos.z - center.z;
+		float e[4] = float[4](dz + half_w, half_w - dz, dx + half_w, half_w - dx);
+		float o[4] = float[4](nb.r, nb.g, nb.b, nb.a);
+		float d = 1e3;
+		for (int i = 0; i < 4; i++) {
+			if (o[i] < 0.5) { d = min(d, e[i]); }
+		}
+		// Fasen: Ecke zwischen zwei freien Kanten
+		int ca[4] = int[4](0, 0, 1, 1);
+		int cb[4] = int[4](2, 3, 2, 3);
+		bool cut = false;
+		for (int k = 0; k < 4; k++) {
+			if (o[ca[k]] < 0.5 && o[cb[k]] < 0.5) {
+				float dd = (e[ca[k]] + e[cb[k]] - chamfer) * 0.70710678;
+				d = min(d, dd);
+				if (dd < 0.0) { cut = true; }
+			}
+		}
+		float hatch = line_aa((fract((wpos.x + wpos.z) / 0.42) - 0.5) * 0.42 * 0.70710678, 0.035);
+		albedo = body_color * 1.3;
+		em = line_base * hatch * 0.18;
+		float rim = line_aa(d - cap_w * 0.5 - 0.03, cap_w);
+		em = mix(em, line_top, rim);
+		if (cut) { albedo = vec3(0.0); em = vec3(0.0); }
+	} else if (abs(wnorm.y) < 0.5) {
+		// Seitenflächen
+		// niedrige Wände (Variante) liegen nah am Auge: Kante und Lichthof mitskalieren
+		float hs = clamp(H / 4.4, 0.35, 1.0);
+		float rim = line_aa(top - edge_w * hs * 0.5, edge_w * hs);
+		float glow = exp(-max(top, 0.0) * 6.0 / hs) * 0.12 * hs;       // Lichthof unter der Kante
+		float base = line_aa(y - base_w * 0.5 - 0.01, base_w);
+		bool face_x = abs(wnorm.x) > 0.5;
+		float along = face_x ? wpos.z : wpos.x;
+		float u = along / dash_len;
+		float fu = fwidth(u);
+		float dash = line_aa((fract(u) - 0.5) * dash_len, dash_len * 0.45);
+		dash = mix(dash, 0.45, clamp(fu * 1.5 - 0.5, 0.0, 1.0));       // auf Distanz zu Mittelwert, nie Moiré
+		float dash_band = line_aa(y - dash_y, dash_h) * dash;
+		// senkrechte Linie nur an freien Enden (Ecken/Öffnungen früh erkennbar)
+		float h = face_x ? (wpos.z - center.z) : (wpos.x - center.x);
+		bool open_neg = face_x ? (nb.r < 0.5) : (nb.b < 0.5);
+		bool open_pos = face_x ? (nb.g < 0.5) : (nb.a < 0.5);
+		float near_fade = smoothstep(1.3, 3.0, length(wpos - INV_VIEW_MATRIX[3].xyz));
+		float vert = 0.0;
+		if (open_neg) { vert = max(vert, line_aa(h + half_w - base_w, base_w * 1.5) * near_fade); }
+		if (open_pos) { vert = max(vert, line_aa(half_w - h - base_w, base_w * 1.5) * near_fade); }
+		float wash = 0.07 * (1.0 - 0.75 * clamp(y / max(H, 0.01), 0.0, 1.0)); // dunkle Türkis-Masse statt Schwarz
+		em = line_top * max(rim, glow) + line_base * max(base, dash_band) + grad * (vert * 0.85 + wash);
+	}
+	if (psychedelic_amount > 0.001) {
+		em = mix(em, hue_shift(em, TIME * 1.7 + wpos.x * 0.3 + wpos.z * 0.2), psychedelic_amount);
+		albedo = mix(albedo, hue_shift(albedo * 3.0, TIME), psychedelic_amount * 0.5);
+	}
+	ALBEDO = albedo;
+	ROUGHNESS = 0.9;
+	EMISSION = em * emission_gain;
+}
